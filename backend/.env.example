GCLI_API_KEY=your-text-relay-key-here
GCLI_BASE_URL=https://gcli.ggchan.dev/v1
GCLI_MODEL=gemini-3-flash-preview

# Optional and kept separate from the text relay. Add these only when
# official web-search and image-generation services are configured.
OPENAI_API_KEY=
PORT=3001

# Optional legacy override for the older single-provider pipeline.
# Leave blank so web search and image generation use official OpenAI.
OPENAI_BASE_URL=
